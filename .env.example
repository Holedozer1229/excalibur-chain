# Excalibur Chain node configuration
# Copy to .env.local — never commit real values.

# Read-only mode: disables sendrawtransaction, submitblock, sendtoaddress
# Set to 1 for public-facing nodes
EXCALIBUR_READ_ONLY=0

# Wallet keyfile path (for encrypted wallets)
# EXCALIBUR_WALLET_KEYFILE=/path/to/keyfile.txt

# Bitcoin RPC credentials (for BTC bridge broadcast)
# EXCAL_BTC_RPC_USER=
# EXCAL_BTC_RPC_PASSWORD=

# Workspace directory for chain data
# EXCAL_WORKSPACE=~/.excalibur
